#!/bin/bash
# Barriere avant tout push de Maillage IoT (depot public ; spec, section 5.1). Installation :
#   cp outils/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
# Ce qui est controle, c'est ce qui part reellement, pas la copie de travail :
#  1. jamais de push force : l'historique distant doit etre connu et ancetre de ce qui part ;
#  2. auteur ET committer de chaque commit pousse = l'adresse noreply ; tagger d'un tag annote aussi ;
#  3. garde.local.txt present et non vide, puis garde des vrais identifiants sur les fichiers suivis (outils/garde.py) ;
#  4. les deux controles d'anonymisation prives (celui de Maillage Thread, celui de Maillage Zigbee) sur le contenu
#     de chaque fichier ajoute ou modifie par chaque commit pousse (commit racine et merges compris), et sur les
#     noms d'auteur et de committer, les messages et les tags annotes.
# Les commits deja connus du remote vise ne sont pas recontroles ; ceux d'un autre remote, si.
# Chaque controle est lance seul et son code de sortie teste : jamais de tube. Jamais de --no-verify.
set -u
attendu="12185352+Djoko-cli@users.noreply.github.com"
zero=0000000000000000000000000000000000000000
distant="${1:-aucun-remote}"
racine=$(git rev-parse --show-toplevel)
anon="$racine/.superpowers/anonymisation"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/contenus"
fautifs=0
n=0
refuser() { echo "pre-push : $1" >&2; fautifs=$((fautifs + 1)); }
while read -r ref_locale sha_local ref_distante sha_distant; do
  [ "$sha_local" = "$zero" ] && continue   # suppression d'une branche distante : rien ne part
  if [ "$(git cat-file -t "$sha_local")" = "tag" ]; then
    n=$((n + 1))
    git cat-file tag "$sha_local" > "$tmp/message-$n.txt"
    te=$(sed -n 's/^tagger .*<\(.*\)>.*/\1/p' "$tmp/message-$n.txt")
    [ "$te" = "$attendu" ] || refuser "tag $ref_locale avec un tagger hors noreply"
  fi
  if [ "$sha_distant" = "$zero" ]; then
    if ! plage=$(git rev-list "$sha_local" --not --remotes="$distant"); then
      refuser "$ref_locale : commits a pousser illisibles"; continue
    fi
  else
    if ! git cat-file -e "$sha_distant^{commit}" 2>/dev/null \
        || ! git merge-base --is-ancestor "$sha_distant" "$sha_local"; then
      refuser "$ref_distante : push force ou historique distant inconnu (recuperer d'abord ; jamais de push force)"
      continue
    fi
    if ! plage=$(git rev-list "$sha_distant..$sha_local"); then
      refuser "$ref_locale : commits a pousser illisibles"; continue
    fi
  fi
  for c in $plage; do
    ae=$(git log -1 --format=%ae "$c"); ce=$(git log -1 --format=%ce "$c")
    if [ "$ae" != "$attendu" ] || [ "$ce" != "$attendu" ]; then
      refuser "commit $(git log -1 --format=%h "$c") avec auteur ou committer hors noreply"
    fi
    n=$((n + 1))
    git log -1 --format='%an%n%cn%n%B' "$c" > "$tmp/message-$n.txt"
    # Chaque fichier ajoute ou modifie, tel qu'il part (un merge : contre chacun de ses parents).
    git diff-tree --root -r -m --no-commit-id --diff-filter=d "$c" > "$tmp/arbre"
    while IFS=$'\t' read -r meta chemin; do
      [ -n "$chemin" ] || continue
      blob=$(echo "$meta" | awk '{print $4}')
      cible="$tmp/contenus/$n/$chemin"
      mkdir -p "$(dirname "$cible")"
      git cat-file blob "$blob" > "$cible" 2>/dev/null || refuser "contenu illisible dans le commit : $chemin"
    done < "$tmp/arbre"
  done
done
if [ ! -s "$racine/garde.local.txt" ]; then
  refuser "garde.local.txt absent ou vide : push refuse"
elif ! python3 "$racine/outils/garde.py"; then
  refuser "la garde a trouve un identifiant reel dans un fichier suivi"
fi
liste=()
while IFS= read -r f; do liste+=("$f"); done < <(find "$tmp/contenus" -type f | sort)
for m in "$tmp"/message-*.txt; do [ -f "$m" ] && liste+=("$m"); done
controler() {  # $1 : nom du controle, $2 : script, $3 : table
  if [ ! -f "$2" ] || [ ! -f "$3" ]; then
    echo "pre-push : controle d'anonymisation $1 introuvable : push refuse" >&2
    return 1
  fi
  [ ${#liste[@]} -eq 0 ] && return 0
  python3 "$2" fichiers --table "$3" "${liste[@]}" > "$tmp/sortie-$1" 2>&1
  code=$?
  tail -1 "$tmp/sortie-$1" >&2
  if [ $code -ne 0 ]; then
    echo "pre-push : le controle $1 a trouve un identifiant" >&2
    return 1
  fi
}
controler thread "$anon/thread/outils/controles.py" "$anon/thread/table.json" || fautifs=$((fautifs + 1))
controler zigbee "$anon/zigbee/controles.py" "$anon/zigbee/table.json" || fautifs=$((fautifs + 1))
[ "$fautifs" -eq 0 ] || { echo "pre-push : push refuse ($fautifs probleme(s))." >&2; exit 1; }
