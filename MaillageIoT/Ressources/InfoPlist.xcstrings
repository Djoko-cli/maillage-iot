{
  "sourceLanguage" : "fr",
  "strings" : {
    "NSAppleEventsUsageDescription" : {
      "comment" : "Autorisation d'Automatisation : l'assistant de reprise demande a Maillage Thread ou Maillage Zigbee de quitter (evenement Apple « quit ») avant de reprendre leurs donnees.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maillage IoT needs to control Maillage Thread or Maillage Zigbee to quit them before importing their data."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maillage IoT a besoin de contrôler Maillage Thread ou Maillage Zigbee pour les quitter avant de reprendre leurs données."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Autorisation reseau local (ecoute Bonjour des routeurs de bordure Thread, des appareils Matter et HomeKit et du pont Hue ; connexion aux sondes Thread et Zigbee par le reseau local).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maillage IoT listens to local network announcements (Thread border routers, Matter and HomeKit devices, Hue bridge) to draw your Thread and Zigbee networks, and connects to your probes over the local network if you choose to."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maillage IoT écoute les annonces du réseau local (routeurs de bordure Thread, appareils Matter et HomeKit, pont Hue) pour dessiner vos réseaux Thread et Zigbee, et se connecte à vos sondes par le réseau local si vous le choisissez."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
