    "macOS a refusé le réseau local à Maillage IoT : l'autoriser dans Réglages Système › Confidentialité et sécurité › Réseau local." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS denied Maillage IoT the local network: allow it in System Settings › Privacy & Security › Local Network."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS a refusé le réseau local à Maillage IoT : l'autoriser dans Réglages Système › Confidentialité et sécurité › Réseau local."
          }
        }
      }
    },
    "macOS demandera l'accord à la première connexion. La clé est alors recopiée dans Maillage IoT ; l'ancienne app garde la sienne et son accès." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS will ask for approval at the first connection. The key is then copied into Maillage IoT; the old app keeps its own key and its access."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS demandera l'accord à la première connexion. La clé est alors recopiée dans Maillage IoT ; l'ancienne app garde la sienne et son accès."
          }
        }
      }
    },
    "macOS n'a pas encore reçu de réponse : accepter la demande d'autorisation de Maillage IoT." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
